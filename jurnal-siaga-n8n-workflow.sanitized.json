    {
      "parameters": {
        "jsCode": "const inputData = $('Normalisasi Data Form').first().json;\n\nconst daftarTanggalRaw = inputData.daftar_tanggal;\nconst bulan = inputData.bulan;\nconst tahun = inputData.tahun;\nconst shiftAwal = inputData.shift_awal;\n\nif (!daftarTanggalRaw || !bulan || !tahun || !shiftAwal) {\n  throw new Error('Salah satu field wajib (daftar_tanggal, bulan, tahun, shift_awal) kosong.');\n}\n\nif (shiftAwal !== 'S1' && shiftAwal !== 'S2') {\n  throw new Error('shift_awal harus berisi \"S1\" atau \"S2\". Nilai diterima: ' + shiftAwal);\n}\n\nconst bulanMap = {\n  'Januari': 0, 'Februari': 1, 'Maret': 2, 'April': 3, 'Mei': 4, 'Juni': 5,\n  'Juli': 6, 'Agustus': 7, 'September': 8, 'Oktober': 9, 'November': 10, 'Desember': 11\n};\n\nif (!(bulan in bulanMap)) {\n  throw new Error('Nama bulan tidak dikenali: ' + bulan + '. Gunakan format \"Januari\"..\"Desember\".');\n}\n\nconst hariNames = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];\n\nconst daftarTanggal = daftarTanggalRaw\n  .toString()\n  .split(',')\n  .map(s => s.trim())\n  .filter(s => s.length > 0);\n\nif (daftarTanggal.length === 0) {\n  throw new Error('daftar_tanggal tidak berisi tanggal yang valid.');\n}\n\nconst results = [];\n\nfor (let i = 0; i < daftarTanggal.length; i++) {\n  const tgl = parseInt(daftarTanggal[i], 10);\n  if (isNaN(tgl)) continue;\n\n  // Pergantian shift per tanggal: index genap = shift_awal, index ganjil = kebalikannya\n  const currentShift = (i % 2 === 0)\n    ? shiftAwal\n    : (shiftAwal === 'S1' ? 'S2' : 'S1');\n\n  const bulanIndex = bulanMap[bulan];\n  const dateObj = new Date(tahun, bulanIndex, tgl);\n  const hari = hariNames[dateObj.getDay()];\n\n  let templateTarget = '';\n  if (currentShift === 'S2') {\n    templateTarget = 'D';\n  } else if (currentShift === 'S1') {\n    if (['Selasa', 'Kamis'].includes(hari)) templateTarget = 'A';\n    else if (['Senin', 'Jumat'].includes(hari)) templateTarget = 'B';\n    else if (['Sabtu', 'Minggu', 'Rabu'].includes(hari)) templateTarget = 'C';\n  }\n\n  if (!templateTarget) {\n    throw new Error('Tidak bisa menentukan template untuk tanggal ' + tgl + ' (' + hari + ', shift ' + currentShift + ').');\n  }\n\n  results.push({\n    json: {\n      tanggal: tgl,\n      hari: hari,\n      shift: currentShift,\n      template_target: templateTarget,\n      sheet_name: tgl + '_' + bulan + '_' + currentShift,\n      hari_cell: hari,\n      tanggal_cell: tgl + ' ' + bulan + ' ' + tahun,\n      bulan: bulan,\n      tahun: tahun\n    }\n  });\n}\n\nreturn results;"
      },
