# ─────────────────────────────────────────────────────────────
#  Jurnal Siaga Generator — TEMPLATE variabel lingkungan
#
#  File INI aman di-commit (portfolio) karena hanya berisi contoh.
#  Salin ke `.env` lalu isi nilai asli. `.env` di-gitignore.
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Spreadsheet MASTER berisi 4 tab template (A/B/C/D)
MASTER_SPREADSHEET_ID=your_master_spreadsheet_id_here

# gid tiap tab template di dalam spreadsheet master
TEMPLATE_A_GID=000000000
TEMPLATE_B_GID=000000000
TEMPLATE_C_GID=000000000
TEMPLATE_D_GID=000000000

# Spreadsheet respons form (sumber baris shift baru)
RESPONSE_SPREADSHEET_ID=your_response_spreadsheet_id_here
RESPONSE_SHEET_GID=000000000

# Email pengirim jurnal ke pengaju
FROM_EMAIL=your_sender_email_here

# Email tujuan notifikasi bila workflow gagal (Error Trigger)
NOTIFY_EMAIL=your_notify_email_here

# Lokasi jadwal sholat (untuk jam nyala/mati lampu dinamis — myquran API)
PRAYER_CITY=Kendari

# Kredensial Google — path ke file service account (JANGAN commit file-nya)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
